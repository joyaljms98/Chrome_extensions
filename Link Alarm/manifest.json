{
  "manifest_version": 3,
  "name": "Link Alarm",
  "description": "A futuristic homepage with time-aware tasks, site reminders, and task cards.",
  "version": "14.9.6",
  "action": {
    "default_popup": "popup.html"
  },
  "chrome_url_overrides": {
    "newtab": "newtab.html"
  },
  "permissions": [
    "notifications",
    "storage",
    "alarms",
    "tabs"
  ],
  "background": {
    "service_worker": "service_worker.js"
  },
  "icons": {
    "128": "assets/icons/icon128.png",
    "48": "assets/icons/icon48.png"
  }
}
